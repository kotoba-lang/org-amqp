;; No dependencies. AMQP 1.0's type system is a self-describing byte codec —
;; a format-code table, big-endian integers, and length-prefixed compound
;; encodings. A leaf that dragged a broker client or a socket library behind
;; it would defeat the point: this is the wire codec, not a client.
{:paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :cljs {:extra-paths ["test"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
